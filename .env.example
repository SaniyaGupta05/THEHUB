# ==============================================================================
# The HUB & HUBKLUB Shopping App - Environment Configuration
# ==============================================================================

# Application & API Mode
APP_NAME="The HUB & HUBKLUB Loyalty API"
APP_VERSION="1.0.0"
DEBUG=true
DEMO_MODE=true

# Integration Adapters ("mock" | "live")
SHOPIFY_INTEGRATION_MODE=mock
HUBKLUB_INTEGRATION_MODE=mock

# Database (defaults to local SQLite for prototype, supports PostgreSQL)
DATABASE_URL=sqlite:///./hubklub_app.db
# For PostgreSQL: postgresql://hub_user:secure_password@localhost:5432/hubklub_db

# ------------------------------------------------------------------------------
# Future Live Shopify Credentials (Storefront API & Customer Account API)
# WARNING: Keep private tokens only in this backend .env file.
# NEVER bundle or expose Shopify Admin or Private tokens inside the mobile app!
# ------------------------------------------------------------------------------
SHOPIFY_STORE_DOMAIN=3tmnjg-dw.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_ADMIN_API_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# Future Live HUBKLUB / Tally ERP Credentials
# Tally must never be exposed directly to the public internet.
# Connect through an approved secure enterprise connector or mutual TLS gateway.
# ------------------------------------------------------------------------------
HUBKLUB_TALLY_ENDPOINT=
HUBKLUB_TALLY_API_KEY=

# ------------------------------------------------------------------------------
# HUBKLUB Loyalty Business Rules Configuration
# ------------------------------------------------------------------------------
# Minimum single purchase required for membership eligibility (INR)
LOYALTY_ELIGIBILITY_MIN_SINGLE_PURCHASE=1000.0

# Annual spending threshold to unlock 20% bonus points (INR)
LOYALTY_ANNUAL_BONUS_SPEND_THRESHOLD=100000.0
LOYALTY_ANNUAL_BONUS_MULTIPLIER=0.20

# Point redemption value (1 Point = 1.0 INR)
LOYALTY_POINT_RUPEE_VALUE=1.0

# Point validity duration (2 years = 730 days)
LOYALTY_POINTS_EXPIRY_DAYS=730

# Mobile App API Endpoint (Set to backend URL)
EXPO_PUBLIC_API_URL=http://localhost:8000
